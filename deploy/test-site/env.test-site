# OrthoTrack TEST SITE — .env for /var/www/orthotrack-test
# Start from .env.example, then set these lines. Everything not listed stays as on the real site
# (mail, backups bucket, PDF, Redis host/password …).
# Replace test.example.com with the real subdomain and every CHANGE-ME.

APP_NAME="OrthoTrack Test"
APP_ENV=production              # same behaviour as the real site; production never seeds demo data
APP_DEBUG=false
APP_URL=https://test.example.com
# APP_KEY: run `php artisan key:generate` — never copy the real site's key

ORTHOTRACK_TEST_SITE=true       # banner on every page, no demo data, allows orthotrack:reset-test-site
ORTHOTRACK_AUTO_LOGIN=                 # test site only: "true" (or a username) = open without signing in; remove for real use
ORTHOTRACK_REQUIRE_ADMIN_MFA=true

# Its own database and login (see deploy/test-site/create-db.sql). Never the real site's database,
# and not orthotrack_test (that one is emptied by the automated tests).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=orthotrack_testsite
DB_USERNAME=orthotrack_testsite
DB_PASSWORD=CHANGE-ME-strong-password

# Same Redis server, kept apart from the real site (own databases and key prefixes).
REDIS_DB=2
REDIS_CACHE_DB=3
REDIS_PREFIX=orthotrack-test-database-
CACHE_PREFIX=orthotrack-test-cache-
HORIZON_PREFIX=orthotrack_test_horizon:

# Own session cookie; leave SESSION_DOMAIN empty so the two sites never share a login.
SESSION_COOKIE=orthotrack_test_session
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true

# Backups of the test site go to their own folder in the bucket (or set BACKUP_BUCKET to another one).
BACKUP_NAME=orthotrack-test

# Own push-notification keys: php artisan webpush:vapid
VAPID_SUBJECT=mailto:CHANGE-ME
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

VITE_APP_NAME="${APP_NAME}"
