# OrthoTrack on Hostinger shared hosting (the doctor's TEST SITE) — copy to .env in the app folder,
# then: php artisan key:generate && php artisan webpush:vapid
# Paths are for account u527134066 and drrajab.coda-agency.net; see docs/HOSTINGER.md.

APP_NAME="OrthoTrack Test"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://drrajab.coda-agency.net
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

ORTHOTRACK_TIMEZONE=Asia/Baghdad
ORTHOTRACK_OPS_ADMIN_EMAIL=ops@coda.agency
ORTHOTRACK_REQUIRE_ADMIN_MFA=true
ORTHOTRACK_TEST_SITE=true              # banner, no demo data, orthotrack:reset-test-site allowed
ORTHOTRACK_QUEUE_VIA_SCHEDULER=true    # no Supervisor here: the cron also runs the queue

LOG_CHANNEL=daily
LOG_LEVEL=warning

# SQLite: one file, outside the website folder (shared hosting has no PostgreSQL).
DB_CONNECTION=sqlite
DB_DATABASE=/home/u527134066/domains/coda-agency.net/drrajab-data/orthotrack.sqlite
DB_FOREIGN_KEYS=true
DB_BUSY_TIMEOUT=10000
DB_TRANSACTION_MODE=IMMEDIATE

# No Redis on shared hosting: sessions, cache and queue in the database.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=orthotrack_test_session
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail: a Hostinger mailbox (hPanel → Emails), or leave on log while testing.
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@coda-agency.net"
MAIL_FROM_NAME="${APP_NAME}"

# Backups stay on this account (storage/app/private/orthotrack-test), kept by backup:clean.
BACKUP_NAME=orthotrack-test
BACKUP_DISK=local
BACKUP_ARCHIVE_PASSWORD=

# PDF download needs Chrome (not on shared hosting): the print page's "Save as PDF" is used instead.
PDF_ENABLED=false

# php artisan webpush:vapid fills these.
VAPID_SUBJECT=mailto:ops@coda.agency
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

VITE_APP_NAME="${APP_NAME}"
