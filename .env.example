APP_NAME=OrthoTrack
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

ORTHOTRACK_TIMEZONE=Asia/Baghdad
ORTHOTRACK_OPS_ADMIN_EMAIL=ops@coda.agency
# Super Admin must set up two-factor before using /admin (keep true in production).
ORTHOTRACK_REQUIRE_ADMIN_MFA=false

# Password used by the demo-user seeder (local/staging only — never runs in production).
DEMO_USER_PASSWORD=Ortho-Demo-2026!

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=orthotrack
DB_USERNAME=orthotrack
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=orthotrack_cache_

# phpredis on the VPS (faster); predis works everywhere without a PHP extension.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=orthotrack_

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@orthotrack.local"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible storage (Backblaze B2) for uploads + backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-004
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

BACKUP_DISK=backups
BACKUP_ARCHIVE_PASSWORD=
BACKUP_BUCKET=
BACKUP_ENDPOINT=

# Web push (php artisan webpush:vapid)
VAPID_SUBJECT="mailto:ops@coda.agency"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

VITE_APP_NAME="${APP_NAME}"

# PDF downloads (Phase 5): headless Chrome path; empty = auto-detect (google-chrome / chromium)
PDF_ENABLED=true
PDF_CHROME_PATH=
